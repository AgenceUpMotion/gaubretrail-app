{
  "name": "gaubretrail-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-assets.mjs && next dev",
    "build": "node scripts/sync-assets.mjs && next build",
    "start": "next start",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.mjs tests/*.test.jsx",
    "test:http": "node scripts/smoke-server.mjs",
    "setup": "node scripts/setup-server.mjs",
    "import:state": "node --env-file-if-exists=.env.local scripts/import-state.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13"
  }
}
