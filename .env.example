# Node.js 24.15+ ; serveur avec disque persistant, une instance applicative.
# npm run setup génère .env.local et un mot de passe aléatoire.
GAUBRE_ADMIN_USERNAME=organisation
GAUBRE_ADMIN_NAME=Organisation GaubreTrail
GAUBRE_ADMIN_PASSWORD_HASH=
GAUBRE_DATABASE_PATH=.storage/gaubretrail.sqlite
# Optionnel : remplace SQLite par Supabase (Postgres). Exécutez d’abord la
# migration dans supabase/migrations/, puis définissez ces valeurs côté serveur.
# Ne créez jamais de variables NEXT_PUBLIC_* pour la clé secrète.
# GAUBRE_STORAGE_DRIVER=supabase
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_SECRET_KEY=
# Ancien nom pris en charge temporairement : SUPABASE_SERVICE_ROLE_KEY=
# URL publique HTTPS exacte en production (contrôle des requêtes d’écriture).
GAUBRE_APP_ORIGIN=http://localhost:3000
